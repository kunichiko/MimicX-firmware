# ===================================================================================
# MimicX-ESP32 BLE-MIDI スケルトン sdkconfig 既定値
# (idf.py が初回に sdkconfig へ展開する。sdkconfig 自体は git 管理外)
# ===================================================================================

# --- Bluetooth: NimBLE (peripheral) を使用、Bluedroid は無効 ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="MimicX"

# BLE-MIDI の SysEx 分割を減らすため MTU を拡張 (§2.3)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# ログを USB シリアルで見やすく
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- コア分離 / 動作周波数 ---
# BLE スタックを core0 に固定し、core1 を I2C ブリッジ (reader task 等) に空ける。
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
# CPU を 240MHz にして BLE⇄I2C 中継のレイテンシを下げる。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
